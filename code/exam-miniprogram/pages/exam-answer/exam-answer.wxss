.answer-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

.answer-top {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.answer-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-right: 24rpx;
}

.answer-countdown {
  font-size: 34rpx;
  font-weight: 600;
  color: #1B5BD7;
  font-variant-numeric: tabular-nums;
}

.countdown-danger {
  color: #ee0a24;
}

.ques-section-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.ques-flag {
  margin-left: auto;
  font-size: 36rpx;
  color: #969799;
}

.flag-on {
  color: #ff976a;
}

.ques-stem {
  padding: 0 32rpx 24rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #323233;
  word-break: break-word;
}

.opt-group {
  padding: 8rpx 0;
}

.opt-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.opt-row:last-child {
  border-bottom: none;
}

.opt-checked {
  background: #eef3fd;
}

.opt-radio {
  width: 44rpx;
  font-size: 32rpx;
  color: #1B5BD7;
  line-height: 1.6;
}

.opt-checkbox {
  width: 36rpx;
  height: 36rpx;
  margin: 4rpx 8rpx 0 0;
  border: 2rpx solid #dcdee0;
  border-radius: 8rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
  flex-shrink: 0;
}

.opt-checked .opt-checkbox {
  background: #1B5BD7;
  border-color: #1B5BD7;
}

.opt-content {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}

.opt-key {
  font-weight: 600;
  margin-right: 8rpx;
}

.blank-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.blank-row:last-child {
  border-bottom: none;
}

.blank-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #646566;
}

.blank-input {
  flex: 1;
  font-size: 28rpx;
}

.essay-input {
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.offline-tip {
  margin: 24rpx 32rpx;
  padding: 16rpx 24rpx;
  background: #fffbe8;
  color: #ed6a0c;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.answer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.act-btn {
  flex: 1;
  font-size: 26rpx;
  line-height: 2.2;
  background: #f2f3f5;
  color: #323233;
  border-radius: 12rpx;
  margin: 0;
}
.act-btn[disabled] {
  color: #c8c9cc;
  background: #f7f8fa;
}

.act-danger {
  background: #ee0a24;
  color: #fff;
}

/* 答题卡弹层 */
.card-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.card-popup {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.card-legend {
  display: flex;
  gap: 32rpx;
  padding: 0 32rpx 16rpx;
  font-size: 24rpx;
  color: #646566;
}

.dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.dot-answered { background: #07c160; }
.dot-unanswered { background: #fff; border: 2rpx solid #dcdee0; }
.dot-marked { background: #ff976a; }

.card-body {
  padding: 0 32rpx;
  flex: 1;
}

.card-section-title {
  font-size: 26rpx;
  color: #646566;
  margin: 20rpx 0 16rpx;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 20rpx;
}

.card-cell {
  position: relative;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dcdee0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #323233;
  background: #fff;
}

.cell-answered {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
}

.cell-current {
  box-shadow: 0 0 0 4rpx #1B5BD7;
}

.cell-mark {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ff976a;
  border: 4rpx solid #fff;
}

.card-footer {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  background: #ee0a24;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.submit-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-loading {
  color: #fff;
  font-size: 30rpx;
}
