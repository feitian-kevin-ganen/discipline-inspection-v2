.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #323233;
  background: #fff;
}

.record-card {
  margin-top: 24rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-stem {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #323233;
}

.record-meta {
  margin-top: 16rpx;
  line-height: 1.8;
}

.record-detail {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #ebedf0;
  font-size: 28rpx;
  line-height: 1.8;
  color: #323233;
}

.record-analysis {
  color: #646566;
}

.list-tip {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}
