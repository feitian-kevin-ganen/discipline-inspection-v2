<view>
  <view wx:if="{{force}}" class="force-tip">
    首次登录须修改初始密码，修改成功后需重新登录。
  </view>

  <view class="card form-group">
    <view class="field">
      <view class="field-label">原密码</view>
      <input class="field-input" password placeholder="请输入原密码" value="{{oldPassword}}" bindinput="onOldInput" />
    </view>
    <view class="field">
      <view class="field-label">新密码</view>
      <input class="field-input" password placeholder="8-32位，须含字母和数字" value="{{newPassword}}" bindinput="onNewInput" />
    </view>
    <view class="field">
      <view class="field-label">确认密码</view>
      <input class="field-input" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmInput" />
    </view>
  </view>

  <view class="submit-btn">
    <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">确认修改</button>
  </view>
</view>
