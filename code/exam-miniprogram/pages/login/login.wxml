<view class="login-page">
  <view class="login-header">
    <view class="login-logo">🛡</view>
    <view class="login-title">纪检监察人员在线考试系统</view>
    <view class="login-sub">微信小程序端</view>
  </view>

  <view class="login-form card">
    <view class="field">
      <view class="field-label">工号</view>
      <input class="field-input" placeholder="请输入工号" value="{{username}}" bindinput="onUserInput" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input class="field-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPwdInput" />
    </view>
  </view>

  <view class="login-btn">
    <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">登 录</button>
  </view>
</view>
