<view>
  <view wx:if="{{loading}}" class="page-loading">加载中...</view>

  <block wx:elif="{{detail.materialId}}">
    <!-- 头部信息 -->
    <view class="meta-bar">
      <text class="tag tag-primary">{{typeName}}</text>
      <text class="text-muted">{{detail.catName}}</text>
      <text class="text-muted">标称时长 {{durationText}}</text>
      <text wx:if="{{completed}}" class="tag tag-success">已完成</text>
    </view>
    <view class="progress detail-progress">
      <view class="progress-inner {{displayProgress >= 100 ? 'done' : ''}}" style="width: {{displayProgress}}%"></view>
    </view>

    <!-- 图文类：富文本渲染（兼容 RICHTEXT/ARTICLE 两种类型标识） -->
    <view wx:if="{{detail.materialType === 'ARTICLE' || detail.materialType === 'RICHTEXT'}}" class="rich-content card">
      <rich-text nodes="{{detail.contentHtml || '<p>暂无内容</p>'}}"></rich-text>
    </view>

    <!-- 文档类（PDF）：下载后打开 -->
    <view wx:elif="{{detail.materialType === 'DOC'}}" class="doc-wrap card">
      <view class="doc-icon">📄</view>
      <view class="doc-title">{{detail.title}}</view>
      <view wx:if="{{detail.pageCount}}" class="text-muted">共 {{detail.pageCount}} 页</view>
      <button class="btn-primary doc-btn" loading="{{opening}}" disabled="{{opening}}" bindtap="openFile">打开文件</button>
      <view class="text-muted doc-tip">文档将在微信内置阅读器中打开</view>
    </view>

    <!-- 视频类：播放器（断点续学） -->
    <view wx:elif="{{detail.materialType === 'VIDEO'}}" class="video-wrap">
      <video
        wx:if="{{fileUrl}}"
        src="{{fileUrl}}"
        initial-time="{{initialTime}}"
        controls
        class="video-player"
        bindplay="onVideoPlay"
        bindpause="onVideoPause"
        bindended="onVideoEnded"
        bindtimeupdate="onVideoTimeUpdate"
      ></video>
      <view wx:else class="page-empty">视频加载失败</view>
      <view class="text-muted video-tip">拖动进度条不影响有效时长统计，请完整观看。</view>
    </view>

    <!-- 简介 -->
    <view wx:if="{{detail.summary}}" class="card summary-group">
      <view class="summary-head">资料简介</view>
      <view class="summary-text">{{detail.summary}}</view>
    </view>
  </block>
</view>
