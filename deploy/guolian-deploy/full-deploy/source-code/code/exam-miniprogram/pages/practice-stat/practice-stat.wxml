<view wx:if="{{stat}}">
  <view class="card stat-grid">
    <view class="stat-item">
      <view class="stat-num">{{stat.totalQuestions || 0}}</view>
      <view class="stat-label">总题量</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stat.accuracyText}}</view>
      <view class="stat-label">正确率</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stat.practiceDays || 0}}</view>
      <view class="stat-label">练习天数</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">按法规正确率</view>
    <view wx:if="{{byLaw.length === 0}}" class="page-empty">暂无数据</view>
    <view wx:for="{{byLaw}}" wx:key="sourceLaw" class="law-row">
      <view class="law-head">
        <text class="law-name ellipsis">{{item.sourceLaw}}</text>
        <text class="text-muted">{{item.questions}} 题 · {{item.accuracyText}}</text>
      </view>
      <view class="progress">
        <view class="{{item.barClass}}" style="width: {{item.accuracyPct}}%"></view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">薄弱知识点</view>
    <view wx:if="{{weakPoints.length === 0}}" class="page-empty">暂无薄弱知识点</view>
    <view wx:for="{{weakPoints}}" wx:key="knowledgePoint" class="weak-row">
      <text class="weak-name">{{item.knowledgePoint}}</text>
      <text class="weak-text">错 {{item.wrongCount}} 次 · 错误率 {{item.wrongRateText}}</text>
    </view>
  </view>
</view>
<view wx:else class="page-loading">加载中...</view>
