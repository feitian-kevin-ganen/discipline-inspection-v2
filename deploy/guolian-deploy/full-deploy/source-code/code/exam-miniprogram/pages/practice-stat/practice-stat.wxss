.stat-grid {
  display: flex;
  padding: 40rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 600;
  color: #1B5BD7;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
}

.law-row {
  padding: 16rpx 0 24rpx;
}

.law-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.law-name {
  flex: 1;
  color: #323233;
}

.bar-danger {
  background: #ee0a24;
}

.weak-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #f2f3f5;
}

.weak-name {
  font-size: 28rpx;
  color: #323233;
}

.weak-text {
  color: #ee0a24;
  font-size: 26rpx;
}
