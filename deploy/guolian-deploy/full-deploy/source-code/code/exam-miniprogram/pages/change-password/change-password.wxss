.force-tip {
  background: #fffbe8;
  color: #ed6a0c;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  line-height: 1.6;
}

.form-group {
  padding: 12rpx 0;
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #646566;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
}

.submit-btn {
  margin: 48rpx 32rpx;
}
