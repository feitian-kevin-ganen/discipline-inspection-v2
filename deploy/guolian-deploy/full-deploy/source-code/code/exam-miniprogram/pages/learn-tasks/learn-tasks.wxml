<view>
  <view class="tabs">
    <view class="tab {{active === 'TODO' ? 'tab-active' : ''}}" data-name="TODO" bindtap="onTabTap">待完成</view>
    <view class="tab {{active === 'DONE' ? 'tab-active' : ''}}" data-name="DONE" bindtap="onTabTap">已完成</view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="page-empty">暂无学习任务</view>

  <view wx:for="{{list}}" wx:key="taskId" class="card task-card">
    <view class="task-head">
      <text class="task-title">{{item.title}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusName}}</text>
    </view>
    <view class="text-muted task-meta">要求时长 {{item.requiredText}} · 截止 {{item.deadline || '-'}}</view>
    <view
      wx:for="{{item.materials}}"
      wx:for-item="m"
      wx:key="materialId"
      class="task-material"
      data-id="{{m.materialId}}"
      bindtap="goMaterial"
    >
      <text class="task-material-icon">{{m.icon}}</text>
      <text class="task-material-title ellipsis">{{m.title}}</text>
      <view class="progress task-material-progress">
        <view class="progress-inner {{m.progressPct >= 100 ? 'done' : ''}}" style="width: {{m.progressPct}}%"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="list-tip">没有更多了</view>
</view>
