<view>
  <view class="tabs-bar">
    <view class="tabs">
      <view class="tab {{active === 'ALL' ? 'tab-active' : ''}}" data-name="ALL" bindtap="onTabTap">全部</view>
      <view class="tab {{active === 'UNREAD' ? 'tab-active' : ''}}" data-name="UNREAD" bindtap="onTabTap">
        未读<text wx:if="{{unreadCount > 0}}" class="unread-num">({{unreadCount}})</text>
      </view>
    </view>
    <view wx:if="{{unreadCount > 0}}" class="read-all" bindtap="onReadAll">全部已读</view>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="page-empty">暂无站内消息</view>

  <view wx:for="{{list}}" wx:key="noticeId" class="card notice-card" data-id="{{item.noticeId}}" data-index="{{index}}" bindtap="onItemTap">
    <view class="notice-head">
      <view wx:if="{{!item.read}}" class="unread-dot"></view>
      <text class="notice-title ellipsis">{{item.title}}</text>
      <text class="tag tag-primary">{{item.typeName}}</text>
    </view>
    <view class="text-muted notice-time">{{item.sendTime}}</view>
    <view wx:if="{{item.expanded}}" class="notice-content">
      <rich-text nodes="{{item.content}}"></rich-text>
    </view>
    <view wx:else class="notice-preview text-muted">点击展开查看详情</view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="list-tip">没有更多了</view>
</view>
