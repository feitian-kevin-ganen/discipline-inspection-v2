.tabs-bar {
  display: flex;
  align-items: center;
  background: #fff;
}

.tabs {
  display: flex;
  flex: 1;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
}

.tab-active {
  color: #1B5BD7;
  font-weight: 600;
  border-bottom-color: #1B5BD7;
}

.unread-num {
  color: #ee0a24;
  font-size: 24rpx;
}

.read-all {
  padding: 0 32rpx;
  font-size: 26rpx;
  color: #1B5BD7;
}

.notice-card {
  margin-top: 24rpx;
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ee0a24;
  flex-shrink: 0;
}

.notice-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.notice-time {
  margin: 12rpx 0;
}

.notice-content {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.8;
  border-top: 2rpx solid #f2f3f5;
  padding-top: 16rpx;
  word-break: break-word;
}

.notice-preview {
  font-size: 24rpx;
}

.list-tip {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}
