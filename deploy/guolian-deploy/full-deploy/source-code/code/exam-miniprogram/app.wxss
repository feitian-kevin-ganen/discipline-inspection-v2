/* 全局样式：品牌色 #1B5BD7，卡片式布局，移动端 rpx 尺寸 */
page {
  background: #f7f8fa;
  color: #323233;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 品牌色变量（WXSS 不支持 CSS 变量到所有组件，统一用字面量 #1B5BD7） */

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.text-muted {
  color: #969799;
  font-size: 24rpx;
}

.text-danger {
  color: #ee0a24;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 主按钮（圆角品牌色） */
.btn-primary {
  background: #1B5BD7;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #a8c2f0;
  color: #fff;
}

.btn-danger-plain {
  background: #fff;
  color: #ee0a24;
  border: 2rpx solid #ee0a24;
  border-radius: 999rpx;
  font-size: 30rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.tag-primary { color: #1B5BD7; border: 2rpx solid #1B5BD7; background: #eef3fd; }
.tag-success { color: #07c160; border: 2rpx solid #07c160; background: #eafff3; }
.tag-danger  { color: #ee0a24; border: 2rpx solid #ee0a24; background: #fff0f0; }
.tag-warning { color: #ff976a; border: 2rpx solid #ff976a; background: #fff7f0; }
.tag-default { color: #969799; border: 2rpx solid #dcdee0; background: #f7f8fa; }

/* 加载 / 空态 */
.page-loading {
  display: block;
  text-align: center;
  margin-top: 160rpx;
  color: #969799;
  font-size: 26rpx;
}
.page-empty {
  text-align: center;
  margin-top: 160rpx;
  color: #969799;
  font-size: 26rpx;
}

/* 进度条（自绘，避免依赖组件库） */
.progress {
  height: 12rpx;
  border-radius: 6rpx;
  background: #ebedf0;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  background: #1B5BD7;
  border-radius: 6rpx;
  transition: width 0.3s;
}
.progress-inner.done {
  background: #07c160;
}
