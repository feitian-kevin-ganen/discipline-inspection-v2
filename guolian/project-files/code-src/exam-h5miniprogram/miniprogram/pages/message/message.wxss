/* pages/message/message.wxss */
.page {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.payload {
  font-size: 28rpx;
  color: #333;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  word-break: break-all;
  white-space: pre-wrap;
}
