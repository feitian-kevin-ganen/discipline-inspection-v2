.tabs {
  display: flex;
  background: #fff;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
}

.tab-active {
  color: #1B5BD7;
  font-weight: 600;
  border-bottom-color: #1B5BD7;
}

.task-card {
  margin-top: 24rpx;
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.task-meta {
  margin: 16rpx 0;
}

.task-material {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.task-material-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.task-material-title {
  flex: 1;
  font-size: 26rpx;
}

.task-material-progress {
  width: 160rpx;
  margin-left: 16rpx;
}

.list-tip {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}
