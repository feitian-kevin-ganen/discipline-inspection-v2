.stat-panel {
  text-align: center;
  padding: 56rpx 32rpx;
  background: #fff;
}

.stat-main {
  font-size: 56rpx;
  font-weight: 700;
  color: #1B5BD7;
  margin-bottom: 12rpx;
}

.stat-grid {
  display: flex;
  background: #fff;
  margin-bottom: 24rpx;
  padding: 24rpx 0 32rpx;
}

.grid-item {
  flex: 1;
  text-align: center;
}

.grid-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #323233;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #323233;
  border-bottom: 2rpx solid #f2f3f5;
}
.stat-row:last-child {
  border-bottom: none;
}

.rate-text {
  color: #07c160;
  font-weight: 600;
}

.cat-item {
  padding: 16rpx 0;
}

.cat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #323233;
  margin-bottom: 12rpx;
}
