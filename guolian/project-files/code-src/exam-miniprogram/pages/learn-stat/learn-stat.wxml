<view>
  <view wx:if="{{loading}}" class="page-loading">加载中...</view>

  <block wx:elif="{{stat}}">
    <view class="stat-panel">
      <view class="stat-main">{{totalDurationText}}</view>
      <view class="text-muted">累计有效学习时长</view>
    </view>

    <view class="stat-grid">
      <view class="grid-item">
        <view class="grid-num">{{ms.completed || 0}}</view>
        <view class="text-muted">已完成资料</view>
      </view>
      <view class="grid-item">
        <view class="grid-num">{{ms.inProgress || 0}}</view>
        <view class="text-muted">学习中</view>
      </view>
      <view class="grid-item">
        <view class="grid-num">{{ms.notStarted || 0}}</view>
        <view class="text-muted">未开始</view>
      </view>
    </view>

    <view class="card stat-group">
      <view class="group-title">学习任务</view>
      <view class="stat-row"><text>任务总数</text><text>{{ts.total || 0}}</text></view>
      <view class="stat-row"><text>已完成</text><text>{{ts.done || 0}}</text></view>
      <view class="stat-row"><text>进行中</text><text>{{ts.doing || 0}}</text></view>
      <view class="stat-row"><text>已逾期</text><text>{{ts.expired || 0}}</text></view>
      <view class="stat-row"><text>完成率</text><text class="rate-text">{{doneRatePct}}%</text></view>
    </view>

    <view wx:if="{{catList.length}}" class="card stat-group">
      <view class="group-title">分类学习分布</view>
      <view wx:for="{{catList}}" wx:key="catId" class="cat-item">
        <view class="cat-head">
          <text>{{item.catName}}</text>
          <text class="text-muted">{{item.durationText}} · 完成 {{item.completedCount || 0}} 项</text>
        </view>
        <view class="progress">
          <view class="progress-inner" style="width: {{item.pct}}%"></view>
        </view>
      </view>
    </view>
  </block>
</view>
