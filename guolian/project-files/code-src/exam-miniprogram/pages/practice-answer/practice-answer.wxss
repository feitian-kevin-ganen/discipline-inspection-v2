.progress-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
  font-size: 28rpx;
  color: #323233;
}

.progress-wrap {
  margin: 0 32rpx;
}

.ques-stem {
  padding: 32rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: #323233;
}

.opt-group {
  padding: 8rpx 24rpx;
}

.opt-item {
  display: flex;
  padding: 24rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.opt-key {
  font-weight: 600;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.opt-selected {
  background: #e8f0fe;
}

.opt-right {
  background: #e8f7ee;
}

.opt-wrong {
  background: #fdecec;
}

.feedback {
  line-height: 1.8;
  font-size: 28rpx;
}

.feedback-tag {
  font-size: 26rpx;
  padding: 4rpx 20rpx;
}

.feedback-line {
  margin-top: 16rpx;
}

.action-btn {
  margin: 40rpx 24rpx;
}

.summary {
  padding: 120rpx 48rpx;
  text-align: center;
}

.summary-icon {
  font-size: 96rpx;
}

.summary-title {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.summary-score {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #646566;
}

.summary-num {
  font-size: 56rpx;
  font-weight: 600;
  color: #1B5BD7;
}

.summary-actions {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-plain {
  background: #fff;
  color: #1B5BD7;
  border: 2rpx solid #1B5BD7;
}
