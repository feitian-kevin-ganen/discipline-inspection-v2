<view>
  <!-- 搜索 + 任务入口 -->
  <view class="search-bar">
    <view class="search-box">
      <input class="search-input" placeholder="搜索资料" value="{{keyword}}" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearch" />
    </view>
    <view class="task-entry" bindtap="goTasks">
      📋
      <view wx:if="{{todoCount > 0}}" class="task-badge">{{todoCount}}</view>
    </view>
  </view>

  <!-- 分类横滚 -->
  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-item {{activeCat === item.key ? 'cat-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCatTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 资料列表 -->
  <view wx:if="{{!loading && list.length === 0}}" class="page-empty">暂无可见学习资料</view>

  <view wx:for="{{list}}" wx:key="materialId" class="card material-card" data-id="{{item.materialId}}" bindtap="goDetail">
    <image wx:if="{{item.coverUrl}}" class="material-cover" src="{{item.coverUrl}}" mode="aspectFill" />
    <view class="material-body">
      <view class="material-title">{{item.title}}</view>
      <view class="text-muted">{{item.catName}}</view>
      <view class="material-tags">
        <text class="tag tag-primary">{{item.typeName}}</text>
        <text class="tag {{item.statusClass}}">{{item.statusName}}</text>
        <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="text-muted tag-item">#{{t}}</text>
      </view>
      <view wx:if="{{item.progressPct > 0}}" class="progress card-progress">
        <view class="progress-inner {{item.progressPct >= 100 ? 'done' : ''}}" style="width: {{item.progressPct}}%"></view>
      </view>
      <view class="text-muted">时长 {{item.durationText}} · 学习 {{item.studyCount}} 人次</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="list-tip">没有更多了</view>
</view>
