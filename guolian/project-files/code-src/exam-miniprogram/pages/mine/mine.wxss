.user-panel {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(135deg, #1B5BD7, #4d82e3);
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.menu-group {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f2f3f5;
}
.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #323233;
}

.menu-arrow {
  color: #c8c9cc;
  font-size: 36rpx;
}

.logout-btn {
  margin: 64rpx 32rpx;
}
