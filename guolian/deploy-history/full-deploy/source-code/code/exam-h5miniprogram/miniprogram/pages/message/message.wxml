<!-- pages/message/message.wxml —— postMessage / navigateTo 消息演示 -->
<view class="page">
  <view class="title">来自 H5 的消息</view>
  <view class="hint">
    H5 端可通过 wx.miniProgram.postMessage({{ '{' }} data: ... {{ '}' }}) 发送消息，
    或使用 wx.miniProgram.navigateTo({ url: '/pages/message/message?payload=...' })
    跳转本页并携带参数。
  </view>
  <view class="payload">{{payloadText}}</view>
</view>
