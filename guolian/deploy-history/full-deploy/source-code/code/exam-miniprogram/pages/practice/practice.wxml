<view>
  <view class="card">
    <view class="section-title">练习模式</view>
    <view class="option-row">
      <view
        class="option-tag {{mode === 'CATEGORY' ? 'option-tag-active' : ''}}"
        data-key="CATEGORY"
        bindtap="onModeTap"
      >按法规分类</view>
      <view
        class="option-tag {{mode === 'RANDOM' ? 'option-tag-active' : ''}}"
        data-key="RANDOM"
        bindtap="onModeTap"
      >全库随机</view>
    </view>
  </view>

  <view wx:if="{{mode === 'CATEGORY'}}" class="card">
    <view class="section-title">选择法规分类</view>
    <view wx:if="{{!banksLoading && banks.length === 0}}" class="page-empty">暂无可用法规分类</view>
    <view
      wx:for="{{banks}}"
      wx:key="bankId"
      class="bank-item {{bankId === item.bankId ? 'bank-item-active' : ''}}"
      data-id="{{item.bankId}}"
      bindtap="onBankTap"
    >
      <text class="bank-name">{{item.bankName}}</text>
      <text class="text-muted">{{item.quesCount}} 题</text>
      <text wx:if="{{bankId === item.bankId}}" class="bank-check">✓</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">题目数量</view>
    <view class="option-row">
      <view
        wx:for="{{counts}}"
        wx:key="*this"
        class="option-tag {{count === item ? 'option-tag-active' : ''}}"
        data-value="{{item}}"
        bindtap="onCountTap"
      >{{item}} 题</view>
    </view>
  </view>

  <view class="start-btn">
    <button class="btn-primary" loading="{{starting}}" disabled="{{starting}}" bindtap="onStart">开始练习</button>
  </view>

  <view class="card menu-group">
    <view class="menu-item" bindtap="goRecords">
      <text class="menu-title">练习记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goStat">
      <text class="menu-title">练习统计</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
