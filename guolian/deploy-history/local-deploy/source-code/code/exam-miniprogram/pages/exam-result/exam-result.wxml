<view>
  <!-- 交卷回执 -->
  <view wx:if="{{submitResult}}" class="result-banner">
    <view class="banner-icon">✅</view>
    <view class="result-banner-title">交卷成功</view>
    <view class="text-muted">交卷时间：{{submitResult.submitTime || '-'}}</view>
    <view wx:if="{{submitResult.unansweredCount > 0}}" class="text-muted">未作答 {{submitResult.unansweredCount}} 题</view>
    <view wx:if="{{submitResult.message}}" class="text-muted">{{submitResult.message}}</view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">成绩查询中...</view>

  <block wx:elif="{{result}}">
    <view wx:if="{{!result.scorePublished}}" class="result-banner">
      <view class="banner-icon">⏳</view>
      <view class="result-banner-title">成绩待发布</view>
      <view class="text-muted">成绩发布后可在此查看，页面每 30 秒自动刷新</view>
    </view>

    <block wx:else>
      <view class="score-panel">
        <view class="score-value">{{result.myScore}}<text class="score-total"> / {{result.totalScore}}</text></view>
        <view class="score-tags">
          <text wx:if="{{result.grade}}" class="tag tag-primary">等级：{{result.grade}}</text>
          <text class="tag {{result.passed ? 'tag-success' : 'tag-danger'}}">{{result.passed ? '合格' : '不合格'}}</text>
        </view>
        <view class="text-muted score-sub">
          <text wx:if="{{result.objectiveScore !== undefined}}">客观题 {{result.objectiveScore}} 分</text>
          <text wx:if="{{result.subjectiveScore !== undefined}}"> · 主观题 {{result.subjectiveScore}} 分</text>
          <text wx:if="{{result.retakeSeq}}"> · 第 {{result.retakeSeq}} 次补考</text>
        </view>
      </view>

      <!-- 题目解析 -->
      <block wx:if="{{result.showAnalysis && details.length}}">
        <view wx:for="{{details}}" wx:key="seq" class="card detail-card">
          <view class="detail-head">
            <text class="tag tag-primary">{{item.quesTypeText}}</text>
            <text class="text-muted">第 {{item.seq}} 题 · 得 {{item.gainedScore}} 分</text>
            <text class="tag {{item.isCorrect ? 'tag-success' : 'tag-danger'}}">{{item.isCorrect ? '正确' : '错误'}}</text>
          </view>
          <view class="detail-stem">
            <rich-text nodes="{{item.stem}}"></rich-text>
          </view>
          <view class="detail-answers">
            <view>我的答案：<text class="{{item.isCorrect ? 'ans-right' : 'ans-wrong'}}">{{item.myAnswerText}}</text></view>
            <view>正确答案：<text class="ans-right">{{item.correctAnswerText}}</text></view>
          </view>
          <view wx:if="{{item.analysis}}" class="detail-analysis">解析：{{item.analysis}}</view>
        </view>
      </block>
      <view wx:else class="card text-muted no-analysis">本场考试未开放答题解析。</view>
    </block>
  </block>

  <view class="back-btn">
    <button class="btn-primary" bindtap="backToExamList">返回考试列表</button>
  </view>
</view>
