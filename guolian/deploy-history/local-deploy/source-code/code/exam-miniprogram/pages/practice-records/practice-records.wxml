<view>
  <view class="switch-row">
    <text>只看错题</text>
    <switch checked="{{onlyWrong}}" color="#1B5BD7" bindchange="onOnlyWrongChange" />
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="page-empty">
    {{onlyWrong ? '暂无错题' : '暂无练习记录'}}
  </view>

  <view wx:for="{{list}}" wx:key="recordId" class="card record-card">
    <view class="record-head">
      <text class="tag {{item.isRight ? 'tag-success' : 'tag-danger'}}">{{item.isRight ? '正确' : '错误'}}</text>
      <text class="text-muted">{{item.answerTimeText}}</text>
    </view>
    <view class="record-stem">{{item.stemText}}</view>
    <view class="record-meta text-muted">
      <view>我的答案：{{item.myAnswerText}}</view>
      <view wx:if="{{item.sourceLaw}}">来源：{{item.sourceLaw}}</view>
    </view>
    <view wx:if="{{item.expanded}}" class="record-detail">
      <view>正确答案：{{item.correctAnswerText}}</view>
      <view wx:if="{{item.analysis}}" class="record-analysis">解析：{{item.analysis}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="list-tip">没有更多了</view>
</view>
