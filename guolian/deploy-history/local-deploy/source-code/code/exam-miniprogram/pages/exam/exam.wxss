.tabs {
  display: flex;
  background: #fff;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
}

.tab-active {
  color: #1B5BD7;
  font-weight: 600;
  border-bottom-color: #1B5BD7;
}

.exam-card {
  margin-top: 24rpx;
}

.exam-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.exam-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.exam-meta {
  margin: 16rpx 0;
  line-height: 1.9;
}

.exam-btn {
  font-size: 26rpx;
  line-height: 2.2;
}

.btn-plain {
  background: #fff;
  color: #1B5BD7;
  border: 2rpx solid #1B5BD7;
}

.btn-disabled {
  background: #f2f3f5;
  color: #969799;
  font-size: 26rpx;
  line-height: 2.2;
  border-radius: 999rpx;
}

.list-tip {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}
