.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
}

.search-box {
  flex: 1;
  background: #f2f3f5;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.search-input {
  font-size: 26rpx;
}

.task-entry {
  position: relative;
  margin-left: 24rpx;
  font-size: 40rpx;
  line-height: 1;
  padding: 8rpx;
}

.task-badge {
  position: absolute;
  top: -4rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #ee0a24;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 6rpx;
}

.cat-scroll {
  background: #fff;
  white-space: nowrap;
  border-top: 2rpx solid #f2f3f5;
}

.cat-row {
  display: inline-flex;
  padding: 0 16rpx;
}

.cat-item {
  display: inline-block;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #646566;
  border-bottom: 4rpx solid transparent;
}

.cat-active {
  color: #1B5BD7;
  font-weight: 600;
  border-bottom-color: #1B5BD7;
}

.material-card {
  display: flex;
}

.material-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f2f3f5;
}

.material-body {
  flex: 1;
  min-width: 0;
}

.material-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0;
}

.tag-item {
  margin-right: 8rpx;
}

.card-progress {
  margin: 12rpx 0;
}

.list-tip {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}
