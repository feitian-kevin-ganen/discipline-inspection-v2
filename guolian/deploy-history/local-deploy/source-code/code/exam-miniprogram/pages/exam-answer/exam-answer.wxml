<view class="answer-page">
  <!-- 顶部：标题 + 倒计时 -->
  <view class="answer-top">
    <view class="answer-title ellipsis">{{examName}}</view>
    <view class="answer-countdown {{countdownDanger ? 'countdown-danger' : ''}}">⏱ {{countdownText}}</view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">试卷加载中...</view>

  <block wx:elif="{{current}}">
    <!-- 题型分区信息 -->
    <view class="ques-section-bar">
      <text class="tag tag-primary">{{current.typeName}}</text>
      <text class="text-muted">第 {{currentIdx + 1}} / {{total}} 题 · {{current.scorePerQues}} 分</text>
      <view class="ques-flag {{current.marked ? 'flag-on' : ''}}" bindtap="toggleMark">{{current.marked ? '🚩' : '⚑'}}</view>
    </view>

    <!-- 题干 -->
    <view class="ques-stem">
      <rich-text nodes="{{current.stem}}"></rich-text>
    </view>

    <!-- 作答控件 -->
    <view class="ques-control">
      <!-- 单选 / 判断 -->
      <view wx:if="{{current.quesType === 'SINGLE' || current.quesType === 'JUDGE'}}" class="card opt-group">
        <view
          wx:for="{{current.options}}"
          wx:key="optKey"
          class="opt-row {{item.checked ? 'opt-checked' : ''}}"
          data-key="{{item.optKey}}"
          bindtap="onOptionTap"
        >
          <view class="opt-radio">{{item.checked ? '●' : '○'}}</view>
          <view class="opt-content">
            <text class="opt-key">{{item.optKey}}.</text>
            <rich-text nodes="{{item.content}}"></rich-text>
          </view>
        </view>
      </view>

      <!-- 多选 -->
      <view wx:elif="{{current.quesType === 'MULTI'}}" class="card opt-group">
        <view
          wx:for="{{current.options}}"
          wx:key="optKey"
          class="opt-row {{item.checked ? 'opt-checked' : ''}}"
          data-key="{{item.optKey}}"
          bindtap="onOptionTap"
        >
          <view class="opt-checkbox">{{item.checked ? '✓' : ''}}</view>
          <view class="opt-content">
            <text class="opt-key">{{item.optKey}}.</text>
            <rich-text nodes="{{item.content}}"></rich-text>
          </view>
        </view>
      </view>

      <!-- 填空 -->
      <view wx:elif="{{current.quesType === 'FILL'}}" class="card opt-group">
        <view wx:for="{{current.blanks}}" wx:key="index" class="blank-row">
          <view class="blank-label">{{item.label}}</view>
          <input class="blank-input" placeholder="请输入答案" value="{{item.value}}" data-index="{{item.index}}" bindinput="onBlankInput" />
        </view>
      </view>

      <!-- 简答 -->
      <view wx:elif="{{current.quesType === 'ESSAY'}}" class="card opt-group">
        <textarea
          class="essay-input"
          placeholder="请输入作答内容"
          value="{{current.essayText}}"
          maxlength="2000"
          bindinput="onEssayInput"
        ></textarea>
      </view>
    </view>

    <view wx:if="{{offlineTip}}" class="offline-tip">答案已本地保存，恢复网络后自动同步</view>

    <!-- 底部操作区 -->
    <view class="answer-actions">
      <button class="act-btn" disabled="{{currentIdx === 0}}" bindtap="gotoPrev">上一题</button>
      <button class="act-btn" bindtap="openCard">答题卡</button>
      <button class="act-btn" disabled="{{currentIdx >= total - 1}}" bindtap="gotoNext">下一题</button>
      <button class="act-btn act-danger" bindtap="onSubmitClick">交卷</button>
    </view>
  </block>

  <!-- 答题卡弹层 -->
  <view wx:if="{{showCard && card}}" class="card-mask" bindtap="closeCard">
    <view class="card-popup" catchtap="noop">
      <view class="card-head">
        <text>答题卡</text>
        <text class="text-muted">已答 {{card.answeredCount}} / {{card.total}}</text>
      </view>
      <view class="card-legend">
        <text><text class="dot dot-answered"></text>已答</text>
        <text><text class="dot dot-unanswered"></text>未答</text>
        <text><text class="dot dot-marked"></text>标记</text>
      </view>
      <scroll-view scroll-y class="card-body">
        <view wx:for="{{card.sections}}" wx:key="quesType" class="card-section">
          <view class="card-section-title">{{item.typeName}}（每题 {{item.scorePerQues}} 分）</view>
          <view class="card-grid">
            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="sheetQuesId"
              class="card-cell {{cell.answered ? 'cell-answered' : ''}} {{cell.isCurrent ? 'cell-current' : ''}}"
              data-idx="{{cell.idx}}"
              bindtap="onCellTap"
            >
              {{cell.seq}}
              <view wx:if="{{cell.marked}}" class="cell-mark"></view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="card-footer">
        <button class="submit-btn" bindtap="onSubmitClick">交卷（未答 {{card.unansweredCount}} 题）</button>
      </view>
    </view>
  </view>

  <!-- 交卷遮罩 -->
  <view wx:if="{{submitting}}" class="submit-overlay">
    <view class="submit-loading">{{submitTip}}</view>
  </view>
</view>
