<view>
  <view class="user-panel">
    <view class="user-avatar">👤</view>
    <view class="user-info">
      <view class="user-name">{{user.name || '-'}}</view>
      <view class="user-meta">工号 {{user.jobNo || '-'}}</view>
      <view class="user-meta">{{user.orgName || '-'}}</view>
    </view>
  </view>

  <view class="card menu-group">
    <view class="menu-item" bindtap="goScores">
      <text class="menu-icon">🏅</text>
      <text class="menu-title">我的成绩</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goLearnStat">
      <text class="menu-icon">📊</text>
      <text class="menu-title">学习统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPracticeRecords">
      <text class="menu-icon">📝</text>
      <text class="menu-title">练习记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPracticeStat">
      <text class="menu-icon">🎯</text>
      <text class="menu-title">练习统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNotices">
      <text class="menu-icon">✉️</text>
      <text class="menu-title">站内信</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goChangePassword">
      <text class="menu-icon">🔒</text>
      <text class="menu-title">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn">
    <button class="btn-danger-plain" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="onLogout">退出登录</button>
  </view>
</view>
