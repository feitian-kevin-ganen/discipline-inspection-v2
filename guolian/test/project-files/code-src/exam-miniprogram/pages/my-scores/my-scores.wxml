<view>
  <view wx:if="{{!loading && list.length === 0}}" class="page-empty">暂无已发布的成绩</view>

  <view wx:for="{{list}}" wx:key="examId" class="card score-card" data-id="{{item.examId}}" bindtap="goResult">
    <view class="score-head">
      <text class="score-name ellipsis">{{item.examName}}</text>
      <text class="score-value {{item.passed ? '' : 'fail'}}">{{item.myScore}}<text class="score-total">/{{item.totalScore}}</text></text>
    </view>
    <view class="score-meta">
      <text wx:if="{{item.grade}}" class="tag tag-primary">{{item.grade}}</text>
      <text class="tag {{item.passed ? 'tag-success' : 'tag-danger'}}">{{item.passed ? '合格' : '不合格'}}</text>
      <text wx:if="{{item.rankInOrg}}" class="text-muted">单位排名 {{item.rankInOrg}}</text>
      <text wx:if="{{item.retakeSeq}}" class="text-muted">第 {{item.retakeSeq}} 次补考</text>
    </view>
    <view class="text-muted">考试时间：{{item.examTime}}</view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="list-tip">没有更多了</view>
</view>
